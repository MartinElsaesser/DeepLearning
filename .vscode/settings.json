{
	"editor.tabSize": 4,
	"editor.useTabStops": true,
	"editor.insertSpaces": true,
	"editor.detectIndentation": false,
	"cSpell.words": [
		"marimo",
		"pyrefly"
	],
	"cSpell.ignorePaths": [
		"package-lock.json",
		"node_modules",
		".venv",
		"uv.lock",
		"uv.lock",
		"vscode-extension",
		".git",
		".vscode/**",
	],
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		"**/__marimo__": true,
		"**/.ruff_cache": true,
		"**/.venv": true,
	}
}